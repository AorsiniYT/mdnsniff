#!/bin/bash
set -e

if [ -z "$1" ]; then
    echo "Usage: ./makefast [win|psv|wiiu]"
    exit 1
fi

MODE="$1"

if [ "$MODE" == "win" ]; then
    BUILD_DIR="build_win"
    echo "[+] Building for Windows in $BUILD_DIR ..."
    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"
    cmake -DCMAKE_TOOLCHAIN_FILE=../toolchain-mingw.cmake ..
    make -j$(nproc)
    echo -e "\n[+] Windows build finished."
elif [ "$MODE" == "psv" ]; then
    if [ -z "$VITASDK" ]; then
        VITASDK=/usr/local/vitasdk
    fi
    BUILD_DIR="build_psv"
    echo "[+] Building for PS Vita in $BUILD_DIR ..."
    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"
    cmake -DCMAKE_TOOLCHAIN_FILE="$VITASDK/share/vita.toolchain.cmake" ..
    make -j$(nproc)
    echo -e "\n[+] PS Vita build finished."
elif [ "$MODE" == "wiiu" ]; then
    if [ -z "$WUT_ROOT" ]; then
        if [ -n "$DEVKITPRO" ]; then
            WUT_ROOT="$DEVKITPRO/wut"
        else
            echo "[!] WUT_ROOT or DEVKITPRO variable not defined."
            exit 1
        fi
    fi
    BUILD_DIR="build_wiiu"
    echo "[+] Building for Wii U in $BUILD_DIR ..."
    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"
    cmake -DCMAKE_TOOLCHAIN_FILE="$WUT_ROOT/share/wut.toolchain.cmake" ..
    make -j$(nproc)
    echo -e "\n[+] Wii U build finished."
else
    echo "[!] Unknown mode: $MODE"
    echo "Usage: ./makefast [win|psv|wiiu]"
    exit 1
fi
